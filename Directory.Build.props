<Project>

  <!-- Configuração comum a todos os projetos da solução -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Metadados do pacote NuGet. São uma PROPOSTA: o pacote não é gerado no build
    (GeneratePackageOnBuild=false) e nada é publicado sem o OK do Vitor.
  -->
  <PropertyGroup>
    <PackageId Condition="'$(MSBuildProjectName)' == 'Omie.Pedidos'">ArrexTec.Omie.Pedidos</PackageId>
    <Version>0.1.0</Version>
    <Authors>ArrexTec</Authors>
    <Company>ArrexTec</Company>
    <Product>ArrexTec.Omie.Pedidos</Product>
    <Copyright>Copyright (c) 2026 ArrexTec</Copyright>
    <Description>Cliente .NET tipado da API oficial do Omie para lançar pedidos de venda: cadastro de clientes e produtos, conta corrente e inclusão de pedido, com tratamento do erro da API (faultstring/faultcode) e nova tentativa no limite de frequência. Sem dependências externas.</Description>
    <PackageTags>omie;erp;pedido;pedido-de-venda;api;http-client;brasil</PackageTags>
    <RepositoryUrl>https://github.com/arrextec/omie-pedidos-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/arrextec/omie-pedidos-dotnet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
